{
  "name": "@jboho/safe-pnpm",
  "version": "2026.10.1",
  "description": "Docker-based pnpm install isolation — protects developer machines from malicious npm lifecycle scripts",
  "author": "Jonathan Boho <jonathan@credstudios.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboho/safe-pnpm.git"
  },
  "bin": {
    "safe-pnpm": "./bin/safe-pnpm.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "oxlint . && biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "files": [
    "bin/",
    "lib/",
    "assets/"
  ],
  "dependencies": {
    "@socketsecurity/cli": "1.1.102"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "oxlint": "^1.68.0"
  }
}
